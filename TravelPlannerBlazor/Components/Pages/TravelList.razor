@page "/travel-list"
@inject TravelDataService DataService

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>📒 My Travel Itinerary</h3>
            <p class="text-muted mb-0">Manage your dream destinations and planned trips.</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2">Total Trips: @trips.Count</span>
    </div>

    <div class="card p-4 shadow-sm border-0 mb-4 bg-light">
        <h5 class="mb-3">Add Custom Trip</h5>
        <div class="row g-3">
            <div class="col-md-5">
                <input type="text" class="form-control" placeholder="Trip Title (e.g., Sylhet Tour)" @bind="newTripTitle" />
            </div>
            <div class="col-md-5">
                <input type="text" class="form-control" placeholder="Location (e.g., Sylhet)" @bind="newTripLocation" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-success w-100" @onclick="AddCustomTrip">Add Trip</button>
            </div>
        </div>
    </div>

    <!-- Saved Trips Cards Grid -->
    @if (trips.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-3 shadow-sm border">
            <div class="fs-1 text-muted mb-2">📭</div>
            <h5 class="text-secondary">No trips added yet!</h5>
            <p class="text-muted small">Go to <a href="explore">Explore Places</a> and add your favorite destinations here.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var trip in trips)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@trip.Title</h5>
                            <p class="card-text text-muted small mb-3">
                                <span class="bi bi-geo-alt-fill text-danger me-1"></span> Location: @trip.Location
                            </p>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTrip(trip)">
                                <span class="bi bi-trash me-1"></span> Remove
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- Smart Travel Packing Checklist Section -->
        <div class="card p-4 shadow-sm border-0 mt-5 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0 fw-bold text-dark">🎒 Smart Packing Checklist</h5>
                    <small class="text-muted">Check off essential items before starting your journey</small>
                </div>
                <span class="badge bg-success px-3 py-2">
                    Packed: @packingItems.Count(x => x.IsChecked) / @packingItems.Count
                </span>
            </div>

            <!-- Add New Item Input -->
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="Add custom item (e.g., Sunglasses, Charger)..."
                       @bind="newPackingItem" @onkeyup="HandleEnterKey" />
                <button class="btn btn-outline-primary" @onclick="AddPackingItem">
                    <span class="bi bi-plus-lg"></span> Add
                </button>
            </div>

            <!-- Checklist Items -->
            <div class="row g-2">
                @foreach (var item in packingItems)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="p-2 border rounded d-flex justify-content-between align-items-center @(item.IsChecked ? "bg-light text-decoration-line-through text-muted" : "")">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="chk_@item.Name" @bind="item.IsChecked" />
                                <label class="form-check-label" for="chk_@item.Name" style="cursor:pointer;">
                                    @item.Name
                                </label>
                            </div>
                            <button class="btn btn-sm text-danger p-0 border-0" @onclick="() => packingItems.Remove(item)" title="Delete">
                                <span class="bi bi-x-circle"></span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Trip> trips = new();
    private string newTripTitle = string.Empty;
    private string newTripLocation = string.Empty;

    protected override void OnInitialized()
    {
        trips = DataService.GetSavedTrips();
    }

    private void AddCustomTrip()
    {
        if (!string.IsNullOrWhiteSpace(newTripTitle))
        {
            DataService.AddTrip(newTripTitle, newTripLocation);
            newTripTitle = string.Empty;
            newTripLocation = string.Empty;
        }
    }

    private void RemoveTrip(Trip trip)
    {
        trips.Remove(trip);
    }
    // Packing Checklist Logic
    private string newPackingItem = string.Empty;
    private List<PackingItem> packingItems = new()
    {
        new PackingItem { Name = "NID / Student ID Card", IsChecked = true },
        new PackingItem { Name = "Power Bank & Charger", IsChecked = false },
        new PackingItem { Name = "First Aid & Basic Medicine", IsChecked = false },
        new PackingItem { Name = "Comfortable Walking Shoes", IsChecked = false },
        new PackingItem { Name = "Cash & bKash Balance", IsChecked = false },
        new PackingItem { Name = "Umbrella / Raincoat", IsChecked = false }
    };

    private void AddPackingItem()
    {
        if (!string.IsNullOrWhiteSpace(newPackingItem))
        {
            packingItems.Add(new PackingItem { Name = newPackingItem, IsChecked = false });
            newPackingItem = string.Empty;
        }
    }

    private void HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddPackingItem();
    }

    private class PackingItem
    {
        public string Name { get; set; } = string.Empty;
        public bool IsChecked { get; set; }
    }
}