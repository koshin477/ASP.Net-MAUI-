@page "/explore"
@inject TravelDataService DataService
@inject NavigationManager NavManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>🇧🇩 Explore Bangladesh</h3>
        <span class="badge bg-primary fs-6">@filteredDestinations.Count Places Found</span>
    </div>

    <!-- Division Filter Buttons -->
    <div class="mb-4 d-flex flex-wrap gap-2">
        @foreach (var div in divisions)
        {
            <button class="btn @(selectedDivision == div ? "btn-primary" : "btn-outline-primary") btn-sm rounded-pill px-3"
                    @onclick="() => FilterByDivision(div)">
                @div
            </button>
        }
    </div>

    <!-- Destination Cards -->
    <div class="row">
        @foreach (var place in filteredDestinations)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@place.ImageUrl" class="card-img-top" alt="@place.Name" style="height: 200px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@place.Name</h5>
                            <span class="badge bg-info text-dark">@place.Category</span>
                        </div>
                        <p class="text-muted small mb-2">📍 @place.District, @place.Division Division</p>
                        <p class="card-text small">@place.Description</p>

                        <div class="mt-auto">
                            <hr />
                            <p class="mb-1 small"><strong>⏳ Ideal Tour:</strong> @place.IdealDuration</p>
                            <p class="mb-2 small"><strong>💰 Est. Cost:</strong> ৳@place.EstimatedCostPerPerson / person</p>

                            <!-- Activities Badges -->
                            <div class="mb-3">
                                @foreach (var act in place.Activities)
                                {
                                    <span class="badge bg-light text-secondary border me-1 mb-1">@act</span>
                                }
                            </div>

                            <div class="mt-auto pt-2">
                                <button class="btn btn-sm btn-primary w-100" @onclick="() => SaveToItinerary(place.Name, place.District)">
                                    <span class="bi bi-bookmark-plus me-1"></span> Add to My Itinerary
                                </button>
                            </div>
                            <div class="d-flex gap-2 mt-auto pt-2">
                                <button class="btn btn-sm btn-outline-secondary w-50" @onclick="() => OpenGuideModal(place)">
                                    <span class="bi bi-info-circle me-1"></span> Guide
                                </button>
                                <button class="btn btn-sm btn-primary w-50" @onclick="() => SaveToItinerary(place.Name, place.District)">
                                    <span class="bi bi-bookmark-plus me-1"></span> Save Trip
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<!-- Destination Travel Guide Modal -->
@if (selectedPlace != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">🧭 @selectedPlace.Name - Travel Guide</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseGuideModal"></button>
                </div>
                <div class="modal-body">
                    <img src="@selectedPlace.ImageUrl" class="img-fluid rounded mb-3 w-100" style="height: 180px; object-fit: cover;" />
                    <p class="text-muted small">@selectedPlace.Description</p>
                    <hr />
                    <ul class="list-unstyled small">
                        <li class="mb-2"><strong>📍 Location:</strong> @selectedPlace.District, @selectedPlace.Division Division</li>
                        <li class="mb-2"><strong>⏳ Recommended Stay:</strong> @selectedPlace.IdealDuration</li>
                        <li class="mb-2"><strong>💵 Est. Budget:</strong> ৳@selectedPlace.EstimatedCostPerPerson / person</li>
                        <li class="mb-2"><strong>🚌 How to Reach:</strong> Direct AC/Non-AC bus or train services are available from Dhaka to @selectedPlace.District.</li>
                        <li class="mb-0"><strong>🌤️ Best Time:</strong> October to March (Pleasant weather for sightseeing).</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseGuideModal">Close</button>
                    <button class="btn btn-primary btn-sm" @onclick="() => { SaveToItinerary(selectedPlace.Name, selectedPlace.District); CloseGuideModal(); }">
                        Add to My Itinerary
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<string> divisions = new();
    private List<Destination> allDestinations = new();
    private List<Destination> filteredDestinations = new();
    private string selectedDivision = "All";

    protected override void OnInitialized()
    {
        divisions = DataService.GetDivisions();
        allDestinations = DataService.GetDestinations();
        filteredDestinations = allDestinations;
    }

    private void FilterByDivision(string division)
    {
        selectedDivision = division;
        if (division == "All")
        {
            filteredDestinations = allDestinations;
        }
        else
        {
            filteredDestinations = allDestinations
                .Where(d => d.Division.Equals(division, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
    private void SaveToItinerary(string placeName, string district)
    {
        DataService.AddTrip(placeName, district);
        NavManager.NavigateTo("travel-list");
    }
    private Destination? selectedPlace = null;

    private void OpenGuideModal(Destination place)
    {
        selectedPlace = place;
    }

    private void CloseGuideModal()
    {
        selectedPlace = null;
    }
}