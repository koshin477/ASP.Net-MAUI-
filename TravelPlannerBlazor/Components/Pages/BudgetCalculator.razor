@page "/budget-calculator"

<div class="container mt-4">
    <div class="mb-4">
        <h3>🧮 Smart Trip Budget Calculator</h3>
        <p class="text-muted">Estimate your total travel expenses instantly before planning your trip.</p>
    </div>

    <div class="row">
        <!-- Input Form -->
        <div class="col-md-6 mb-4">
            <div class="card p-4 shadow-sm border-0">
                <h5 class="mb-3">Trip Details</h5>

                <div class="mb-3">
                    <label class="form-label">Destination Type</label>
                    <select class="form-select" @bind="selectedCategory">
                        <option value="Standard">Standard / Budget (৳2,500/day)</option>
                        <option value="Comfort">Comfort / Mid-range (৳5,000/day)</option>
                        <option value="Luxury">Luxury Resort Style (৳10,000/day)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Number of Persons: <strong>@numberOfPersons</strong></label>
                    <input type="range" class="form-range" min="1" max="10" @bind="numberOfPersons" @bind:event="oninput" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Duration (Days): <strong>@numberOfDays days</strong></label>
                    <input type="range" class="form-range" min="1" max="15" @bind="numberOfDays" @bind:event="oninput" />
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="guideCheck" @bind="includeGuide" />
                    <label class="form-check-label" for="guideCheck">
                        Include Local Tour Guide (+$1500 flat)
                    </label>
                </div>
            </div>
        </div>

        <!-- Expense Summary -->
        <div class="col-md-6 mb-4">
            <div class="card p-4 shadow-sm border-0 bg-light h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="mb-3 text-primary">📊 Cost Breakdown</h5>
                    <hr />
                    <div class="d-flex justify-content-between mb-2">
                        <span>Base Cost per Day:</span>
                        <strong>৳@GetBaseDailyRate()</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Duration & Persons:</span>
                        <span>@numberOfDays Days × @numberOfPersons Persons</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Guide Fee:</span>
                        <span>@(includeGuide ? "৳1,500" : "৳0")</span>
                    </div>
                </div>

                <div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Total Estimated:</h4>
                        <h3 class="text-success mb-0">৳@CalculateTotal()</h3>
                    </div>
                    <button class="btn btn-primary w-100" @onclick="SaveBudget">Save This Plan</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string selectedCategory = "Comfort";
    private int numberOfPersons = 2;
    private int numberOfDays = 3;
    private bool includeGuide = false;

    private decimal GetBaseDailyRate()
    {
        return selectedCategory switch
        {
            "Standard" => 2500m,
            "Comfort" => 5000m,
            "Luxury" => 10000m,
            _ => 4000m
        };
    }

    private decimal CalculateTotal()
    {
        decimal dailyRate = GetBaseDailyRate();
        decimal subtotal = dailyRate * numberOfDays * numberOfPersons;
        decimal guideFee = includeGuide ? 1500m : 0m;
        return subtotal + guideFee;
    }

    private void SaveBudget()
    {
        // ভবিষ্যতে ডাটাবেস বা সেভ লজিক এখানে যুক্ত করা যাবে
    }
}