@page "/packages"
@inject TravelDataService DataService

<div class="container mt-4">
    <div class="mb-4">
        <h3>🎒 Exclusive Tour Packages</h3>
        <p class="text-muted">Choose pre-planned hassle-free tour packages for your next vacation in Bangladesh.</p>
    </div>

    <div class="row">
        @foreach (var pkg in packages)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@pkg.ImageUrl" class="card-img-top" alt="@pkg.PackageName" style="height: 220px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title">@pkg.PackageName</h5>
                            <span class="badge bg-success">@pkg.Division Division</span>
                        </div>

                        <p class="mb-2 text-muted small"><strong>⏳ Duration:</strong> @pkg.Duration</p>
                        <h4 class="text-primary mb-3">৳@pkg.PricePerPerson <span class="fs-6 text-muted">/ person</span></h4>

                        <div class="mb-3">
                            <p class="mb-1 small fw-bold">What's Included:</p>
                            <ul class="small text-muted ps-3 mb-0">
                                @foreach (var feature in pkg.IncludedFeatures)
                                {
                                    <li>@feature</li>
                                }
                            </ul>
                        </div>

                        <div class="mt-auto">
                            <button class="btn btn-outline-primary w-100" @onclick="() => BookPackage(pkg.PackageName)">
                                Book This Package
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<TourPackage> packages = new();

    protected override void OnInitialized()
    {
        packages = DataService.GetPackages();
    }

    private void BookPackage(string packageName)
    {
        // ভবিষ্যতে এখানে বুকিং সাকসেস মেসেজ বা পপআপ দেখানো যাবে
        System.Diagnostics.Debug.WriteLine($"Booked: {packageName}");
    }
}